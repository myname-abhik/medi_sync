# Copy to .env and fill in. Never commit .env.

PORT=8000

# MongoDB connection string (Atlas or local), e.g. mongodb+srv://USER:PASSWORD@cluster.mongodb.net/medisync
MONGO_URI= mongodb+srv://roha:roha1234@cluster0.bbxtgyl.mongodb.net/

# Long random string used to sign login tokens, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="kichuekta"

# Comma-separated list of frontend origins allowed by CORS (leave empty to allow any origin)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (profile pictures, product and doctor images). Optional: uploads are disabled without it.
CLOUDINARY_CLOUD_NAME=dfkhg7gkp
CLOUDINARY_API_KEY=357518649149878
CLOUDINARY_API_SECRET=4mNntvZI9Bb30TBLYr4gt4UANaQ

# Secret sent as the `x-admin-key` header to create products and doctors (POST /medicine, POST /services).
# Those endpoints are disabled while this is empty.
ADMIN_KEY=1214

# Where the website is hosted. Lets the admin panel preview images stored as /images/... paths.
FRONTEND_URL=http://localhost:5173
