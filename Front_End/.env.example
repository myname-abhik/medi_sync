# Copy to .env only if you need to change something. With no .env the site works out of the box.

# auto (default): use the backend when it is reachable and its database is connected, otherwise
#                 fall back to the built-in static data. Decided at runtime, no restart needed.
# true:  always static (no backend calls at all)
# false: always use the backend
VITE_USE_STATIC=auto

# Backend URL (checked in auto mode, used in API mode)
# VITE_API_URL=http://localhost:8000/
VITE_API_URL=https://medi-sync-ej4w.vercel.app

# Optional. When set (and VITE_USE_STATIC is not "true") these are used automatically:
# real video calls (https://console.zegocloud.com; the test-token helper exposes the secret to the
# browser, so use it for development only) and a Chatbase assistant instead of the built-in one.
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=
VITE_CHATBASE_ID=
